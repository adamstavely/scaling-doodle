          "value": 8,
          "unit": "px"
        },
        "$description": "The tint gradient strip"
      },
      "keyframe-label": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      },
      "zoom-label": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "centre-marker": {
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$description": "Burst centre on the preview"
      },
      "handle-line": {
