      },
      "page-narrow": {
        "$value": "{tc.space.3}"
      },
      "card": {
        "$value": "{tc.space.6}"
      },
      "card-narrow": {
        "$value": "{tc.space.3}"
      },
      "panel": {
        "$value": "{tc.space.5}"
      },
      "section": {
        "$value": "{tc.space.6}",
        "$description": "Between groups of settings"
      },
      "field": {
        "$value": "{tc.space.3}",
        "$description": "Between a heading and its control"
      },
      "tile-gap": {
        "$value": "{tc.space.2}"
      },
      "preview": {
        "$value": "{tc.space.6}"
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{tc.radius.3xl}"
      },
      "panel": {
        "$value": "{tc.radius.2xl}"
      },
      "tile": {
        "$value": "{tc.radius.xl}"
      },
      "frame": {
        "$value": "{tc.radius.md}"
      },
