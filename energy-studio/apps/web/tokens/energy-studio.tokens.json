          "value": 48,
          "unit": "px"
        },
        "$description": "Lucide icon in the empty preview"
      },
      "status-icon": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "dimension-field": {
        "$value": {
          "value": 112,
          "unit": "px"
        },
        "$description": "Custom width / height fields"
      },
