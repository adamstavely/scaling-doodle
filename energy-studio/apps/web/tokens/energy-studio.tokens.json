        "$value": {
          "value": 400,
          "unit": "px"
        }
      },
      "preview-min-height": {
        "$value": {
          "value": 280,
          "unit": "px"
        }
      },
      "tile-icon": {
        "$value": {
          "value": 28,
          "unit": "px"
