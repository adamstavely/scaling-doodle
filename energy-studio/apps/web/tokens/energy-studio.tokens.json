      "card": {
        "$value": "{tc.shadow.overlay}"
      },
      "tile": {
        "$value": "{tc.shadow.raised}"
      },
      "tile-hover": {
        "$value": "{tc.shadow.raised-hover}"
      },
      "frame": {
        "$value": "{tc.shadow.overlay}"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{tc.font.sans}"
      },
      "wordmark-size": {
        "$type": "dimension",
        "$value": "{tc.font-size.3xl}"
      },
      "wordmark-weight": {
        "$type": "fontWeight",
        "$value": "{tc.font-weight.semibold}"
      },
      "wordmark-line-height": {
        "$type": "dimension",
        "$value": "{tc.line-height.display}"
      },
      "heading-size": {
        "$type": "dimension",
        "$value": "{tc.title.font-size}"
      },
      "heading-weight": {
        "$type": "fontWeight",
        "$value": "{tc.title.font-weight}"
      },
      "heading-line-height": {
        "$type": "dimension",
        "$value": "{tc.title.line-height}"
      },
      "tile-size": {
        "$type": "dimension",
        "$value": "{tc.font-size.sm}"
      },
      "body-size": {
        "$type": "dimension",
        "$value": "{tc.font-size.md}"
      },
      "body-line-height": {
        "$type": "dimension",
        "$value": "{tc.line-height.normal}"
      },
      "empty-title-size": {
        "$type": "dimension",
        "$value": "{tc.font-size.xl}"
      }
    },
    "motion": {
      "tile-duration": {
        "$type": "duration",
        "$value": "{tc.duration.fast}"
      },
      "tile-ease": {
        "$type": "cubicBezier",
        "$value": "{tc.ease.out}"
      },
      "tile-press-scale": {
        "$type": "number",
        "$value": 0.97
      }
    },
    "effect": {
      "$type": "number",
      "backdrop-opacity": {
        "$value": 0.45,
        "$description": "The blurred copy of the image behind the card"
      },
      "backdrop-saturate": {
        "$value": 1.2
      },
      "mask-opacity": {
        "$value": 0.45
      },
      "disabled-opacity": {
        "$value": 0.4
      }
    }
  }
}
