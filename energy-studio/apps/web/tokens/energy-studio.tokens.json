{
  "$description": "Energy Studio's own design tokens (DTCG format). Most values alias Trench Coat's DTCG tokens under `tc.` (Clean look, see @adamstavely/trenchcoat/tokens/dtcg). Only sizes Trench Coat has no token for are literal. `npm run tokens -w @energy-studio/web` writes them to src/styles/tokens.css as --es-* custom properties.",
  "es": {
    "color": {
      "$type": "color",
      "page": {
        "$value": "{tc.surface.sunken}",
        "$description": "Page behind the studio card"
      },
      "card": {
        "$value": "{tc.surface.raised}",
        "$description": "The studio card"
      },
      "panel": {
        "$value": "{tc.surface.tray}",
        "$description": "Settings panel and footer bar: a tray the tiles sit on"
      },
      "tile": {
        "$value": "{tc.surface.on-tray}",
        "$description": "An option tile on the panel"
      },
      "tile-selected": {
        "$value": "{tc.fill.selected}"
      },
      "tile-selected-border": {
        "$value": "{tc.border.selected}"
      },
      "tile-selected-text": {
        "$value": "{tc.accent.text}"
      },
      "illustration": {
        "$value": "{tc.accent.text}",
        "$description": "The empty-state picture"
      },
      "axis-guide": {
        "$value": "{tc.text.on-accent}",
        "$description": "The axis line over the image, drawn in difference blend"
      },
      "drop": {
        "$value": "{tc.accent.subtle}",
        "$description": "Preview area while a file is dragged over it"
      },
      "drop-outline": {
        "$value": "{tc.accent}"
      },
      "busy": {
        "$value": "{tc.surface.inverse}",
        "$description": "Render and recording progress pill over the preview"
      },
      "busy-text": {
        "$value": "{tc.text.on-inverse}"
      },
      "mask": {
        "$value": "{tc.accent}",
        "$description": "Tint over protected parts of the photo while painting the mask"
      }
    },
    "size": {
      "$type": "dimension",
      "card-max-width": {
        "$value": {
          "value": 1480,
          "unit": "px"
        }
      },
      "card-max-height": {
        "$value": {
          "value": 900,
          "unit": "px"
        }
      },
      "card-min-height": {
        "$value": {
          "value": 640,
          "unit": "px"
        }
      },
      "panel-min-width": {
        "$value": {
          "value": 330,
          "unit": "px"
        }
      },
